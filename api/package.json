{
  "name": "@jp-orchestrator/api",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/persistence/schema.sql dist/persistence/ && cp -r src/persistence/migrations dist/persistence/",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.8",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
