# API
PORT=3001
DATABASE_URL=postgres://jp:jp@localhost:5432/orchestrator
REDIS_URL=redis://localhost:6379
WEBHOOK_URL=http://localhost:3001/webhooks/inbox
# Event signing secret. The default below is public: with NODE_ENV=production the API refuses to boot with it
# (16+ characters required). Generate one: openssl rand -hex 24
WEBHOOK_SECRET=dev-secret-change-me
# Auth: "key:role[:name],..." with role viewer < operator < approver < admin (each includes the previous).
# name is the identity recorded on approvals. Keys need 16+ characters (openssl rand -hex 24).
# Empty = open mode (no auth), allowed only when NODE_ENV is not production.
API_KEYS=
# Origins allowed by CORS (comma separated). Default outside production: http://localhost:3000; in production: none.
CORS_ORIGINS=http://localhost:3000
# Rate limit on mutating endpoints (create, approve, reject, resume, model toggle), per key and IP, per replica
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# JSON body limit (413 above it)
BODY_LIMIT=64kb
# Logs: one JSON object per line (default) or Nest's colored text (LOG_FORMAT=text)
LOG_FORMAT=json
MOCK_LATENCY_MS=700
MAX_PARALLEL=4
CACHE_SIMILARITY=0.92
GATEWAY_MAX_PROMPT_TOKENS=8000
GATEWAY_MAX_OUTPUT_TOKENS=512
TASK_TIMEOUT_MS=180000
SUBAGENT_TIMEOUT_MS=30000
# Execution lease per task (heartbeat every third of it); also the resume sweep interval
TASK_LEASE_MS=30000
# How long a cancelled run may take to stop before its lease is released
ABORT_GRACE_MS=5000
# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# Dashboard key (sent as X-API-Key, ?api_key= on SSE and the CSV link). Shipped in the browser bundle:
# whoever opens the dashboard can read it. Leave empty when the API runs in open mode.
NEXT_PUBLIC_API_KEY=
