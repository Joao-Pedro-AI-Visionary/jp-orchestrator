# Copie para .env (o compose lê este arquivo) e gere os segredos:
#   openssl rand -hex 32
# API_KEY, WEBHOOK_SECRET, POSTGRES_PASSWORD e REDIS_PASSWORD não têm padrão: o compose não sobe sem eles.
# API_KEY e WEBHOOK_SECRET:: a API não sobe com API_KEY ausente/curta e,
# com NODE_ENV=production, também não sobe com WEBHOOK_SECRET ausente, curto (< 32) ou igual ao antigo exemplo.

# API
PORT=3001
# Interface de escuta. Padrão 127.0.0.1; a imagem Docker usa 0.0.0.0 (o compose publica só em 127.0.0.1).
HOST=127.0.0.1
# Chave exigida em toda rota (header x-api-key ou Authorization: Bearer; no SSE /events também ?api_key=).
API_KEY=
WEBHOOK_SECRET=
# Origens permitidas no CORS, separadas por vírgula. Obrigatório em produção; "*" não é aceito.
CORS_ORIGIN=http://localhost:3000
# Rate limit por IP, janela fixa: todas as rotas e, mais apertado, POST /tasks.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1800
RATE_LIMIT_TASKS_MAX=20
# Lease de execução por tarefa (renovado a cada 1/3). Uma réplica que morre libera a tarefa após esse prazo.
TASK_LEASE_MS=30000
# Senhas do Postgres e do Redis do compose (publicados só em 127.0.0.1). Use hex: entram nas URLs abaixo.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Para rodar a API fora do Docker contra o compose, troque <senha> pelos valores acima.
DATABASE_URL=postgres://jp:<senha>@localhost:5432/orchestrator
REDIS_URL=redis://:<senha>@localhost:6379
WEBHOOK_URL=http://localhost:3001/webhooks/inbox
MOCK_LATENCY_MS=700
MAX_PARALLEL=4
CACHE_SIMILARITY=0.92
GATEWAY_MAX_PROMPT_TOKENS=8000
GATEWAY_MAX_OUTPUT_TOKENS=512
TASK_TIMEOUT_MS=180000
SUBAGENT_TIMEOUT_MS=30000
# Web
# Vazio (padrão): o navegador chama /api no próprio dashboard e o servidor do Next repassa para
# API_INTERNAL_URL, lida em runtime (a mesma imagem serve qualquer host). Preencha NEXT_PUBLIC_API_URL
# só para o navegador falar direto com a API (fixada no build; exige a origem em CORS_ORIGIN).
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=
# Igual à API_KEY. Vai embutida no bundle do navegador: só para demo local, não exponha o dashboard.
NEXT_PUBLIC_API_KEY=
